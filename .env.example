# Copy to backend/.env and fill in. Never commit the real file.
#
# Mock mode (the default) makes ZERO paid/rate-limited API calls.
# Real mode (groq / real) consumes Groq rate limit and TypeSafe credits.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://health:health@localhost:5432/health

# --- LLM (Groq) -------------------------------------------------------------
LLM_PROVIDER=mock                 # mock | groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b     # needs strict json_schema support
LLM_TIMEOUT_SECONDS=20

# --- Jev (TypeSafe) ---------------------------------------------------------
JEV_PROVIDER=mock                 # mock | real
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=15

# --- Workflow / safety ------------------------------------------------------
MAX_TURNS=8
MOCK_LLM_FAIL_MODE=none          # fault injection for mock mode
MOCK_JEV_FAIL_MODE=none
CONFIDENCE_ESCALATION_THRESHOLD=0.6
HUMAN_REVIEW_THRESHOLD=0.5

# --- Public demo limits (only enforced when a real provider is enabled) -----
DAILY_CONVERSATION_CAP=25        # Groq free tier ~200K tokens/day ~= 20-30 conversations; check your console
DAILY_JEV_CALL_CAP=300
CONVERSATIONS_PER_IP_PER_HOUR=3

# --- Frontend -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3100"]

# --- Observability ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=health-backend
LOG_LEVEL=INFO
